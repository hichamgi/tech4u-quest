{
  "name": "tech4u/tech4u-quest",
  "description": "Application web éducative gamifiée pour l'évaluation des connaissances.",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "check": "php tests/router_check.php && php tests/health_check.php"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
